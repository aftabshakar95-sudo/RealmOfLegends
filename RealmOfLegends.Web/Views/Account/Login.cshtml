@model RealmOfLegends.Web.Models.ViewModels.LoginViewModel
@using System.Linq
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Realm of Legends</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Crimson+Pro:wght@300;400;600&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reset.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--color-bg-dark) 0%, var(--color-primary) 100%);
            position: relative;
            overflow-y: auto;
        }
        
        .background-grid {
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(233, 69, 96, 0.1) 1px, transparent 1px);
            background-size: 50px 50px;
            animation: gridMove 20s linear infinite;
            z-index: 1;
        }
        
        @@keyframes gridMove {
            0% { transform: translate(0, 0); }
            100% { transform: translate(50px, 50px); }
        }
        
        .auth-container {
            position: relative;
            z-index: 2;
            background: rgba(26, 26, 46, 0.95);
            border: 2px solid rgba(233, 69, 96, 0.3);
            border-radius: var(--border-radius-lg);
            padding: var(--spacing-3xl);
            max-width: 500px;
            width: 90%;
            box-shadow: var(--shadow-xl), 0 0 40px rgba(233, 69, 96, 0.2);
        }
        
        .auth-header {
            text-align: center;
            margin-bottom: var(--spacing-2xl);
        }
        
        .auth-logo {
            font-size: var(--text-4xl);
            font-family: var(--font-display);
            color: var(--color-accent);
            text-shadow: 0 0 20px rgba(233, 69, 96, 0.5);
            margin-bottom: var(--spacing-sm);
        }
        
        .auth-subtitle {
            font-family: var(--font-body);
            color: var(--color-muted);
            font-size: var(--text-lg);
        }
        
        .form-group {
            margin-bottom: var(--spacing-lg);
        }
        
        .form-label {
            display: block;
            font-family: var(--font-ui);
            font-weight: 600;
            color: var(--color-text);
            margin-bottom: var(--spacing-sm);
            font-size: var(--text-sm);
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .form-control {
            width: 100%;
            padding: var(--spacing-md);
            background: rgba(15, 15, 30, 0.8);
            border: 2px solid rgba(138, 138, 170, 0.3);
            border-radius: var(--border-radius-md);
            color: var(--color-text);
            font-family: var(--font-body);
            font-size: var(--text-base);
            transition: all var(--transition-fast);
        }
        
        .form-control:focus {
            outline: none;
            border-color: var(--color-accent);
            box-shadow: 0 0 15px rgba(233, 69, 96, 0.3);
        }
        
        .form-control::placeholder {
            color: var(--color-muted);
        }
        
        .form-check {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
            font-family: var(--font-ui);
            color: var(--color-text);
        }
        
        .form-check input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }
        
        .validation-error {
            color: var(--color-error);
            font-size: var(--text-sm);
            margin-top: var(--spacing-xs);
            font-family: var(--font-ui);
        }
        
        .btn-primary {
            width: 100%;
            padding: var(--spacing-md) var(--spacing-xl);
            background: var(--color-accent);
            color: white;
            border: none;
            border-radius: var(--border-radius-md);
            font-family: var(--font-ui);
            font-weight: 700;
            font-size: var(--text-lg);
            cursor: pointer;
            transition: all var(--transition-fast);
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 0 20px rgba(233, 69, 96, 0.4);
        }
        
        .btn-primary:hover {
            background: #ff5070;
            box-shadow: 0 0 30px rgba(233, 69, 96, 0.6);
            transform: translateY(-2px);
        }
        
        .btn-primary:active {
            transform: translateY(0);
        }
        
        .auth-footer {
            text-align: center;
            margin-top: var(--spacing-xl);
            padding-top: var(--spacing-lg);
            border-top: 1px solid rgba(138, 138, 170, 0.2);
        }
        
        .auth-footer p {
            font-family: var(--font-body);
            color: var(--color-muted);
            margin-bottom: var(--spacing-sm);
        }
        
        .auth-footer a {
            color: var(--color-accent);
            text-decoration: none;
            font-weight: 600;
            transition: color var(--transition-fast);
        }
        
        .auth-footer a:hover {
            color: #ff5070;
            text-decoration: underline;
        }
        
        .alert {
            padding: var(--spacing-md);
            border-radius: var(--border-radius-md);
            margin-bottom: var(--spacing-lg);
            font-family: var(--font-ui);
            font-size: var(--text-sm);
        }
        
        .alert-danger {
            background: rgba(255, 51, 51, 0.1);
            border: 1px solid rgba(255, 51, 51, 0.3);
            color: var(--color-error);
        }
    </style>
</head>
<body>
    <div class="background-grid"></div>
    
    <div class="auth-container fade-in">
        <div class="auth-header">
            <h1 class="auth-logo">REALM OF LEGENDS</h1>
            <p class="auth-subtitle">Return to Your Adventure</p>
        </div>
        
        @if (ViewData.ModelState != null && !ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger">
                <ul style="margin: 0; padding-left: 1.5rem;">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }
        
        <form asp-action="Login" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="@ViewData["ReturnUrl"]" />
            
            <div class="form-group">
                <label class="form-label" asp-for="Email">Email Address</label>
                <input class="form-control" asp-for="Email" type="email" placeholder="hero@realm.com" autofocus />
                <span asp-validation-for="Email" class="validation-error"></span>
            </div>
            
            <div class="form-group">
                <label class="form-label" asp-for="Password">Password</label>
                <input class="form-control" asp-for="Password" type="password" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="validation-error"></span>
            </div>
            
            <div class="form-group">
                <div class="form-check">
                    <input asp-for="RememberMe" type="checkbox" id="rememberMe" />
                    <label for="rememberMe">Remember me for 14 days</label>
                </div>
            </div>
            
            <button type="submit" class="btn-primary">
                Enter the Realm
            </button>
        </form>
        
        <div class="auth-footer">
            <p>Don't have an account?</p>
            <a asp-action="Register" asp-controller="Account">Create a new account</a>
        </div>
    </div>
</body>
</html>
