@{
    ViewData["Title"] = "Slider Puzzle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .game-container {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            position: relative;
        }

        .game-panel {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 3rem;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            max-width: 600px;
            width: 100%;
            text-align: center;
        }

        .game-title {
            font-size: 2.5rem;
            font-weight: 800;
            color: #f5576c;
            margin: 0 0 1rem 0;
        }

        .game-stats {
            display: flex;
            gap: 1.5rem;
            justify-content: center;
            margin-bottom: 2rem;
        }

        .stat-box {
            padding: 0.75rem 1.5rem;
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            border-radius: 10px;
            color: white;
        }

        .stat-label {
            font-size: 0.85rem;
            opacity: 0.9;
        }

        .stat-value {
            font-size: 1.5rem;
            font-weight: 700;
            margin-left: 0.5rem;
        }

        .puzzle-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.5rem;
            margin: 2rem auto;
            max-width: 400px;
            background: rgba(0, 0, 0, 0.1);
            padding: 0.5rem;
            border-radius: 15px;
        }

        .puzzle-tile {
            aspect-ratio: 1;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            font-weight: 800;
            color: white;
            cursor: pointer;
            transition: all 0.2s ease;
            user-select: none;
        }

        .puzzle-tile:hover:not(.empty) {
            transform: scale(1.05);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .puzzle-tile.empty {
            background: rgba(0, 0, 0, 0.05);
            cursor: default;
        }

        .puzzle-tile.movable {
            cursor: pointer;
            animation: pulse 1s ease-in-out infinite;
        }

        @@keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }

        .game-buttons {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
        }

        .btn {
            flex: 1;
            padding: 1rem 2rem;
            border: none;
            border-radius: 10px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(245, 87, 108, 0.4);
        }

        .btn-secondary {
            background: #e0e0e0;
            color: #333;
        }

        .btn-secondary:hover {
            background: #d0d0d0;
        }

        .result-message {
            margin-top: 1rem;
            padding: 1rem;
            border-radius: 10px;
            font-weight: 600;
            display: none;
        }

        .result-message.success {
            background: #d4edda;
            color: #155724;
            display: block;
        }
    </style>
}

<div class="game-container">
    <div class="game-panel">
        <h1 class="game-title">🧩 Slider Puzzle</h1>
        <p class="game-instructions">
            Arrange the tiles in order from 1 to 8!
        </p>

        <div class="game-stats">
            <div class="stat-box">
                <span class="stat-label">Moves:</span>
                <span class="stat-value" id="moves">0</span>
            </div>
            <div class="stat-box">
                <span class="stat-label">Time:</span>
                <span class="stat-value" id="time">0s</span>
            </div>
        </div>

        <div class="puzzle-grid" id="puzzleGrid">
            <!-- Tiles will be generated by JavaScript -->
        </div>

        <div class="game-buttons">
            <button class="btn btn-primary" id="shuffleBtn" onclick="startGame()">Start Game</button>
            <button class="btn btn-primary" id="submitSolutionBtn" onclick="submitSolution()" disabled>Submit Solution</button>
            <a href="@Url.Action("Index", "Quest")" class="btn btn-secondary">Back to Quests</a>
        </div>

        <div class="result-message" id="resultMessage"></div>
    </div>
</div>

@section Scripts {
    <script>
        let tiles = [];
        let emptyIndex = 8;
        let moves = 0;
        let gameStarted = false;
        let startTime = 0;
        let timerInterval;

        function createSolvablePuzzle() {
            // Start with solved state
            tiles = [1, 2, 3, 4, 5, 6, 7, 8, 0];
            
            // Make random valid moves to shuffle
            for (let i = 0; i < 100; i++) {
                const movableTiles = getMovableTiles();
                const randomTile = movableTiles[Math.floor(Math.random() * movableTiles.length)];
                swapTiles(randomTile, emptyIndex);
            }
        }

        function getMovableTiles() {
            const movable = [];
            const row = Math.floor(emptyIndex / 3);
            const col = emptyIndex % 3;
            
            // Check adjacent tiles
            if (row > 0) movable.push(emptyIndex - 3); // Top
            if (row < 2) movable.push(emptyIndex + 3); // Bottom
            if (col > 0) movable.push(emptyIndex - 1); // Left
            if (col < 2) movable.push(emptyIndex + 1); // Right
            
            return movable;
        }

        function swapTiles(index1, index2) {
            [tiles[index1], tiles[index2]] = [tiles[index2], tiles[index1]];
            if (tiles[index1] === 0) emptyIndex = index1;
            if (tiles[index2] === 0) emptyIndex = index2;
        }

        function renderPuzzle() {
            const grid = document.getElementById('puzzleGrid');
            grid.innerHTML = '';
            
            const movableTiles = getMovableTiles();
            
            tiles.forEach((value, index) => {
                const tile = document.createElement('div');
                tile.className = 'puzzle-tile';
                
                if (value === 0) {
                    tile.classList.add('empty');
                } else {
                    tile.textContent = value;
                    if (movableTiles.includes(index)) {
                        tile.classList.add('movable');
                    }
                    tile.addEventListener('click', () => moveTile(index));
                }
                
                grid.appendChild(tile);
            });
        }

        function moveTile(index) {
            if (!gameStarted) {
                alert('Click Start Game first!');
                return;
            }
            
            const movableTiles = getMovableTiles();
            if (!movableTiles.includes(index)) return;
            
            swapTiles(index, emptyIndex);
            moves++;
            document.getElementById('moves').textContent = moves;
            renderPuzzle();
            
            if (checkWin()) {
                // enable submit button instead of auto-submitting
                document.getElementById('submitSolutionBtn').disabled = false;
                const resultDiv = document.getElementById('resultMessage');
                resultDiv.className = 'result-message success';
                resultDiv.textContent = `Completed! Click Submit to claim rewards.`;
                clearInterval(timerInterval);
                gameStarted = false;
            }
        }

        function checkWin() {
            for (let i = 0; i < 8; i++) {
                if (tiles[i] !== i + 1) return false;
            }
            return tiles[8] === 0;
        }

        function startGame() {
            gameStarted = true;
            moves = 0;
            startTime = Date.now();
            
            document.getElementById('moves').textContent = '0';
            document.getElementById('time').textContent = '0s';
            document.getElementById('shuffleBtn').disabled = true;
            document.getElementById('resultMessage').style.display = 'none';
            
            createSolvablePuzzle();
            renderPuzzle();
            
            timerInterval = setInterval(updateTimer, 1000);
        }

        function updateTimer() {
            const elapsed = Math.floor((Date.now() - startTime) / 1000);
            document.getElementById('time').textContent = `${elapsed}s`;
        }

        function endGame() {
            gameStarted = false;
            clearInterval(timerInterval);
            const elapsed = Math.floor((Date.now() - startTime) / 1000);

            // enable submit button so player can claim reward
            document.getElementById('submitSolutionBtn').disabled = false;
        }

        async function submitScore(moves, time) {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                
                const response = await fetch('@Url.Action("SubmitSliderPuzzle", "Quest")', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ moves, time })
                });

                const data = await response.json();
                const resultDiv = document.getElementById('resultMessage');
                
                if (data.success) {
                    resultDiv.className = 'result-message success';
                    resultDiv.textContent = `Solved in ${moves} moves! Earned ${data.rewards.gold} gold and ${data.rewards.xp} XP!`;

                    const qs = new URLSearchParams({ gold: data.rewards.gold, xp: data.rewards.xp, msg: 'Slider Puzzle completed' });
                    setTimeout(() => {
                        window.location.href = '@Url.Action("Index", "Quest")' + '?' + qs.toString();
                    }, 1400);
                }
            } catch (error) {
                console.error('Error submitting score:', error);
            }
        }

        function submitSolution() {
            const elapsed = Math.floor((Date.now() - startTime) / 1000) || 0;
            submitScore(moves, elapsed);
            document.getElementById('submitSolutionBtn').disabled = true;
        }

        // Initialize with solved puzzle
        tiles = [1, 2, 3, 4, 5, 6, 7, 8, 0];
        renderPuzzle();
    </script>
    
    @Html.AntiForgeryToken()
}
