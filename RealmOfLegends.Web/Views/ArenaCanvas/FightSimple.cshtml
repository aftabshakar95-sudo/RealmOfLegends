// ── DIFFERENT ENEMY TYPES ── //

// Level 1: Goblin Scout (Green, small, agile)
function drawGoblinScout(s, anim) {
    let lean = 0.1, armAngle = 0, headAngle = 0;
    if(anim.state === 'attack') { lean = 0.3; armAngle = 1.2; headAngle = 0.3; }
    if(anim.state === 'hit') { lean = -0.2; headAngle = -0.3; }

    ctx.rotate(lean);
    const skinColor = '#4CAF50'; // Green
    const darkSkin = '#2E7D32';

    // Small goblin body
    ctx.fillStyle = skinColor;
    ctx.beginPath(); ctx.ellipse(0, 0, s*0.25, s*0.35, 0, 0, Math.PI*2); ctx.fill();

    // Head (big ears)
    ctx.save(); ctx.translate(s*0.2, -s*0.25); ctx.rotate(headAngle);
    ctx.fillStyle = skinColor;
    ctx.beginPath(); ctx.ellipse(0, 0, s*0.2, s*0.15, 0, 0, Math.PI*2); ctx.fill();
    // Big ears
    ctx.fillStyle = darkSkin;
    ctx.beginPath(); ctx.ellipse(-s*0.15, -s*0.05, s*0.08, s*0.12, -0.5, 0, Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.ellipse(s*0.15, -s*0.05, s*0.08, s*0.12, 0.5, 0, Math.PI*2); ctx.fill();
    // Red eyes
    ctx.fillStyle = '#F44336';
    ctx.beginPath(); ctx.ellipse(-s*0.05, 0, s*0.03, s*0.03, 0, 0, Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.ellipse(s*0.05, 0, s*0.03, s*0.03, 0, 0, Math.PI*2); ctx.fill();
    ctx.restore();

    // Arms with crude weapon
    ctx.save(); ctx.translate(s*0.1, -s*0.1); ctx.rotate(armAngle);
    ctx.fillStyle = skinColor;
    ctx.beginPath(); ctx.ellipse(0, s*0.2, s*0.08, s*0.25, 0, 0, Math.PI*2); ctx.fill();
    // Crude spear
    ctx.strokeStyle = '#8D6E63'; ctx.lineWidth = s*0.02;
    ctx.beginPath(); ctx.moveTo(0, s*0.4); ctx.lineTo(s*0.1, s*0.8); ctx.stroke();
    ctx.restore();
}

// Level 2: Skeleton Warrior (Bone white, undead)
function drawSkeletonWarrior(s, anim) {
    let lean = 0.1, armAngle = 0;
    if(anim.state === 'attack') { lean = 0.4; armAngle = 1.5; }
    if(anim.state === 'hit') { lean = -0.3; }

    ctx.rotate(lean);
    const boneColor = '#EEEEEE';
    const darkBone = '#9E9E9E';

    // Ribcage
    ctx.strokeStyle = boneColor; ctx.lineWidth = s*0.03;
    for(let i=0; i<5; i++) {
        ctx.beginPath();
        ctx.arc(0, -s*0.2 + i*s*0.08, s*0.15, 0, Math.PI);
        ctx.stroke();
    }

    // Spine
    ctx.strokeStyle = darkBone; ctx.lineWidth = s*0.05;
    ctx.beginPath(); ctx.moveTo(0, -s*0.3); ctx.lineTo(0, s*0.4); ctx.stroke();

    // Skull head
    ctx.save(); ctx.translate(s*0.2, -s*0.4);
    ctx.fillStyle = boneColor;
    ctx.beginPath(); ctx.ellipse(0, 0, s*0.18, s*0.15, 0, 0, Math.PI*2); ctx.fill();
    // Eye sockets (glowing blue)
    ctx.fillStyle = '#2196F3'; ctx.shadowBlur = 10; ctx.shadowColor = '#2196F3';
    ctx.beginPath(); ctx.ellipse(-s*0.06, -s*0.02, s*0.04, s*0.04, 0, 0, Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.ellipse(s*0.06, -s*0.02, s*0.04, s*0.04, 0, 0, Math.PI*2); ctx.fill();
    ctx.shadowBlur = 0;
    ctx.restore();

    // Bony arm with sword
    ctx.save(); ctx.translate(s*0.1, -s*0.1); ctx.rotate(armAngle);
    ctx.strokeStyle = boneColor; ctx.lineWidth = s*0.04;
    ctx.beginPath(); ctx.moveTo(0, 0); ctx.lineTo(0, s*0.3); ctx.stroke();
    // Sword
    ctx.fillStyle = '#607D8B';
    ctx.fillRect(-s*0.02, s*0.3, s*0.04, s*0.25);
    ctx.fillRect(-s*0.08, s*0.28, s*0.16, s*0.04); // crossguard
    ctx.restore();
}
// Level 3: Forest Wolf (Brown/purple, beast-like)
function drawForestWolf(s, anim) {
    let lean = 0.2, tailWag = Math.sin(frame*0.15);
    if(anim.state === 'attack') { lean = 0.6; }
    if(anim.state === 'hit') { lean = -0.2; }

    ctx.rotate(lean * 0.3);
    const furColor = '#8D6E63';
    const darkFur = '#5D4037';

    // Body (wolf-like, horizontal)
    ctx.fillStyle = furColor;
    ctx.beginPath(); ctx.ellipse(0, s*0.1, s*0.4, s*0.2, 0, 0, Math.PI*2); ctx.fill();

    // Legs
    ctx.fillStyle = darkFur;
    for(let i=0; i<4; i++) {
        let legX = -s*0.2 + (i%2)*s*0.3;
        let legY = s*0.25 + Math.floor(i/2)*s*0.1;
        ctx.beginPath(); ctx.ellipse(legX, legY, s*0.06, s*0.2, 0, 0, Math.PI*2); ctx.fill();
    }

    // Wolf head (elongated snout)
    ctx.save(); ctx.translate(s*0.35, -s*0.1);
    ctx.fillStyle = furColor;
    ctx.beginPath(); ctx.ellipse(0, 0, s*0.2, s*0.12, 0, 0, Math.PI*2); ctx.fill();
    // Snout
    ctx.fillStyle = darkFur;
    ctx.beginPath(); ctx.ellipse(s*0.15, s*0.02, s*0.08, s*0.06, 0, 0, Math.PI*2); ctx.fill();
    // Glowing purple eyes
    ctx.fillStyle = '#9C27B0'; ctx.shadowBlur = 8; ctx.shadowColor = '#9C27B0';
    ctx.beginPath(); ctx.ellipse(-s*0.05, -s*0.03, s*0.03, s*0.03, 0, 0, Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.ellipse(s*0.03, -s*0.03, s*0.03, s*0.03, 0, 0, Math.PI*2); ctx.fill();
    ctx.shadowBlur = 0;
    // Ears
    ctx.fillStyle = furColor;
    ctx.beginPath(); ctx.moveTo(-s*0.12, -s*0.08); ctx.lineTo(-s*0.18, -s*0.15); ctx.lineTo(-s*0.08, -s*0.12); ctx.fill();
    ctx.beginPath(); ctx.moveTo(s*0.08, -s*0.08); ctx.lineTo(s*0.14, -s*0.15); ctx.lineTo(s*0.04, -s*0.12); ctx.fill();
    ctx.restore();

    // Tail
    ctx.save(); ctx.translate(-s*0.35, s*0.1); ctx.rotate(tailWag * 0.5);
    ctx.fillStyle = furColor;
    ctx.beginPath(); ctx.ellipse(0, 0, s*0.25, s*0.08, -0.3, 0, Math.PI*2); ctx.fill();
    ctx.restore();
}

// Level 5: Golem of Ruin (BOSS - Large, fiery rock creature)
function drawGolemOfRuin(s, anim) {
    const bossScale = gameState.enemyIsBoss ? 1.5 : 1; // Bigger if boss
    s *= bossScale;
    
    let lean = 0.1, armAngle = 0;
    if(anim.state === 'attack') { lean = 0.5; armAngle = 2; }
    if(anim.state === 'hit') { lean = -0.2; }

    ctx.rotate(lean * 0.5);
    const rockColor = '#8D6E63';
    const lavaColor = '#FF5722';

    // Massive rocky body
    ctx.fillStyle = rockColor;
    ctx.beginPath(); ctx.ellipse(0, 0, s*0.5, s*0.6, 0, 0, Math.PI*2); ctx.fill();

    // Lava cracks
    ctx.strokeStyle = lavaColor; ctx.lineWidth = s*0.03; ctx.shadowBlur = 15; ctx.shadowColor = lavaColor;
    ctx.beginPath(); ctx.moveTo(-s*0.3, -s*0.2); ctx.quadraticCurveTo(0, 0, s*0.3, s*0.2); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(-s*0.2, s*0.1); ctx.quadraticCurveTo(s*0.1, s*0.3, s*0.2, s*0.4); ctx.stroke();
    ctx.shadowBlur = 0;

    // Rocky head
    ctx.save(); ctx.translate(s*0.2, -s*0.5);
    ctx.fillStyle = rockColor;
    ctx.beginPath(); ctx.ellipse(0, 0, s*0.25, s*0.2, 0, 0, Math.PI*2); ctx.fill();
    // Glowing lava eyes
    ctx.fillStyle = lavaColor; ctx.shadowBlur = 20; ctx.shadowColor = lavaColor;
    ctx.beginPath(); ctx.ellipse(-s*0.08, 0, s*0.06, s*0.06, 0, 0, Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.ellipse(s*0.08, 0, s*0.06, s*0.06, 0, 0, Math.PI*2); ctx.fill();
    ctx.shadowBlur = 0;
    ctx.restore();

    // Massive arm
    ctx.save(); ctx.translate(s*0.3, -s*0.2); ctx.rotate(armAngle);
    ctx.fillStyle = rockColor;
    ctx.beginPath(); ctx.ellipse(0, s*0.3, s*0.15, s*0.4, 0, 0, Math.PI*2); ctx.fill();
    // Boulder fist
    ctx.beginPath(); ctx.ellipse(0, s*0.7, s*0.2, s*0.2, 0, 0, Math.PI*2); ctx.fill();
    ctx.restore();
}

// Generic monster (fallback) - use original design
function drawGenericMonster(s, anim) {
    drawOriginalMonster(s, anim);
}

// Levels 4, 6-10: Simplified different colored variants for remaining
function drawDarkElfArcher(s, anim) { drawColoredVariant(s, anim, '#37474F', '#00695C'); }
function drawIceBanshee(s, anim) { drawColoredVariant(s, anim, '#E1F5FE', '#03A9F4'); }
function drawStoneGolemJunior(s, anim) { drawColoredVariant(s, anim, '#6D4C41', '#FF9800'); }
function drawShadowAssassin(s, anim) { drawColoredVariant(s, anim, '#1A1A1A', '#7B1FA2'); }
function drawFireDrake(s, anim) { drawColoredVariant(s, anim, '#D84315', '#FF5722'); }
function drawLichKing(s, anim) { 
    const bossScale = gameState.enemyIsBoss ? 1.8 : 1;
    drawColoredVariant(s * bossScale, anim, '#FAFAFA', '#4A148C'); 
}

function drawColoredVariant(s, anim, primaryColor, accentColor) {
    let lean = 0.2, armAngle = 0, headAngle = 0;
    if(anim.state === 'attack') { lean = 0.6; armAngle = 1.5; headAngle = 0.5; }
    if(anim.state === 'hit') { lean = -0.2; headAngle = -0.4; }

    ctx.rotate(lean);

    // Body with custom colors
    ctx.fillStyle = primaryColor;
    ctx.beginPath(); ctx.ellipse(0, 0, s*0.35, s*0.45, 0.2, 0, Math.PI*2); ctx.fill();

    // Head
    ctx.save(); ctx.translate(s*0.3, -s*0.3); ctx.rotate(headAngle);
    ctx.fillStyle = primaryColor;
    ctx.beginPath(); ctx.moveTo(0, s*0.1); ctx.lineTo(s*0.3, -s*0.1); ctx.lineTo(s*0.2, -s*0.25); ctx.lineTo(-s*0.1, -s*0.2); ctx.fill();
    // Glowing Eyes with accent color
    ctx.fillStyle = accentColor; ctx.shadowBlur=12; ctx.shadowColor=accentColor;
    ctx.beginPath(); ctx.ellipse(s*0.08, -s*0.15, s*0.06, s*0.03, 0.2, 0, Math.PI*2); ctx.fill();
    ctx.shadowBlur = 0;
    ctx.restore();

    // Arm 
    ctx.save(); ctx.translate(s*0.1, -s*0.1); ctx.rotate(armAngle);
    ctx.fillStyle = primaryColor;
    ctx.beginPath(); ctx.ellipse(0, s*0.3, s*0.08, s*0.3, -0.2, 0, Math.PI*2); ctx.fill();
    // Weapon/claw with accent color
    ctx.fillStyle = accentColor;
    ctx.beginPath(); ctx.moveTo(-s*0.03, s*0.5); ctx.lineTo(s*0.08, s*0.8); ctx.lineTo(s*0.03, s*0.5); ctx.fill();
    ctx.restore();
}

function drawOriginalMonster(s, anim) {
    let lean = 0.2, armAngle = 0, headAngle = 0;
    if(anim.state === 'attack') { lean = 0.6; armAngle = 1.5; headAngle = 0.5; }
    if(anim.state === 'hit') { lean = -0.2; headAngle = -0.4; }

    ctx.rotate(lean);

    // Original monster design (as fallback)
    const skinDark = ctx.createRadialGradient(0,0,0,0,0,s);
    skinDark.addColorStop(0, '#3E2723'); skinDark.addColorStop(1, '#000');
    
    const skinLight = ctx.createLinearGradient(-s*0.3, -s*0.3, s*0.3, s*0.5);
    skinLight.addColorStop(0, '#4E342E'); skinLight.addColorStop(1, '#1B0000');

    // Massive Torso
    ctx.fillStyle = skinLight;
    ctx.beginPath(); ctx.ellipse(0, 0, s*0.4, s*0.5, 0.2, 0, Math.PI*2); ctx.fill();

    // Head
    ctx.save(); ctx.translate(s*0.3, -s*0.3); ctx.rotate(headAngle);
    ctx.fillStyle = skinDark;
    ctx.beginPath(); ctx.moveTo(0, s*0.1); ctx.lineTo(s*0.4, -s*0.1); ctx.lineTo(s*0.3, -s*0.3); ctx.lineTo(-s*0.2, -s*0.2); ctx.fill();
    // Glowing Eyes
    ctx.fillStyle = '#FF1744'; ctx.shadowBlur=15; ctx.shadowColor='#FF1744';
    ctx.beginPath(); ctx.ellipse(s*0.1, -s*0.2, s*0.08, s*0.03, 0.2, 0, Math.PI*2); ctx.fill();
    ctx.shadowBlur = 0;
    ctx.restore();

    // Arm / Claws
    ctx.save(); ctx.translate(s*0.1, -s*0.1); ctx.rotate(armAngle);
    ctx.fillStyle = skinLight;
    ctx.beginPath(); ctx.ellipse(0, s*0.3, s*0.1, s*0.4, -0.2, 0, Math.PI*2); ctx.fill();
    ctx.restore();
}