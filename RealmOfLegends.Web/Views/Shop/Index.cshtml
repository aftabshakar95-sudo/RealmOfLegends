@using RealmOfLegends.Core.Entities
@{
    ViewData["Title"] = "Shop";
    var player = ViewBag.Player as Player;
    var items = ViewBag.Items as List<Item> ?? new List<Item>();
    var currentCategory = ViewBag.CurrentCategory as string ?? "all";
    var currentRarity = ViewBag.CurrentRarity as string ?? "all";
    var currentSort = ViewBag.CurrentSort as string ?? "default";
}

@section Styles {
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
}

<div class="shop-container">
    <div class="shop-header fade-in">
        <h1 class="page-title">🏪 Merchant's Shop</h1>
        <p class="page-subtitle">Equip yourself for the battles ahead</p>
        
        <div class="player-wallet">
            <span class="wallet-icon">💰</span>
            <span class="wallet-label">Your Gold:</span>
            <span class="wallet-amount" id="playerGold">@player?.Gold</span>
        </div>
    </div>
    
    <div class="shop-controls panel fade-in">
        <div class="filters">
            <div class="filter-group">
                <label>Category:</label>
                <select id="categoryFilter" onchange="applyFilters()">
                    <option value="all">All Items</option>
                    <option value="Weapon">⚔️ Weapons</option>
                    <option value="Armor">🛡️ Armor</option>
                    <option value="Consumable">🧪 Consumables</option>
                    <option value="Accessory">💎 Accessories</option>
                    <option value="Material">📦 Materials</option>
                </select>
            </div>
            
            <div class="filter-group">
                <label>Rarity:</label>
                <select id="rarityFilter" onchange="applyFilters()">
                    <option value="all">All Rarities</option>
                    <option value="Common">Common</option>
                    <option value="Uncommon">Uncommon</option>
                    <option value="Rare">Rare</option>
                    <option value="Epic">Epic</option>
                    <option value="Legendary">Legendary</option>
                </select>
            </div>
            
            <div class="filter-group">
                <label>Sort By:</label>
                <select id="sortFilter" onchange="applyFilters()">
                    <option value="default">Default</option>
                    <option value="name">Name (A-Z)</option>
                    <option value="price-asc">Price (Low to High)</option>
                    <option value="price-desc">Price (High to Low)</option>
                    <option value="rarity">Rarity</option>
                </select>
            </div>
        </div>
        
        <div class="item-count">
            <span>Showing @items.Count items</span>
        </div>
    </div>
    
    <div class="shop-grid">
        @foreach(var item in items)
        {
            var rarityClass = item.Rarity.ToLower();
            var canAfford = player != null && player.Gold >= item.Price;
            
            <div class="shop-item panel @rarityClass scale-up" data-item-id="@item.ItemId">
                <div class="item-rarity-badge @rarityClass">@item.Rarity</div>
                
                <div class="item-icon">
                    @switch(item.Category)
                    {
                        case "Weapon": <span class="icon-emoji">⚔️</span> break;
                        case "Armor": <span class="icon-emoji">🛡️</span> break;
                        case "Consumable": <span class="icon-emoji">🧪</span> break;
                        case "Accessory": <span class="icon-emoji">💎</span> break;
                        case "Material": <span class="icon-emoji">📦</span> break;
                        default: <span class="icon-emoji">✨</span> break;
                    }
                </div>
                
                <h3 class="item-name">@item.Name</h3>
                <p class="item-category">@item.Category</p>
                <p class="item-description">@item.Description</p>
                
                @if(!string.IsNullOrEmpty(item.StatJson) && item.StatJson != "{}")
                {
                    <div class="item-stats">
                        <span class="stat-bonus">@item.StatJson</span>
                    </div>
                }
                
                <div class="item-footer">
                    <div class="item-price">
                        <span class="price-icon">💰</span>
                        <span class="price-value">@item.Price</span>
                    </div>
                    
                    @if(canAfford)
                    {
                        <button class="btn btn-buy" onclick="purchaseItem(@item.ItemId, '@item.Name', @item.Price)">
                            Buy Now
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-disabled" disabled title="Insufficient gold">
                            Need @(item.Price - (player?.Gold ?? 0)) more gold
                        </button>
                    }
                </div>
            </div>
        }
    </div>
    
    @if(items.Count == 0)
    {
        <div class="empty-state panel">
            <div class="empty-icon">📦</div>
            <h3>No items found</h3>
            <p>Try adjusting your filters</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Set selected values on page load
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('categoryFilter').value = '@currentCategory';
            document.getElementById('rarityFilter').value = '@currentRarity';
            document.getElementById('sortFilter').value = '@currentSort';
        });
        
        function applyFilters() {
            const category = document.getElementById('categoryFilter').value;
            const rarity = document.getElementById('rarityFilter').value;
            const sort = document.getElementById('sortFilter').value;
            
            let url = '@Url.Action("Index", "Shop")?';
            if (category !== 'all') url += `category=${category}&`;
            if (rarity !== 'all') url += `rarity=${rarity}&`;
            if (sort !== 'default') url += `sort=${sort}&`;
            
            window.location.href = url;
        }
        
        async function purchaseItem(itemId, itemName, itemPrice) {
            if (!confirm(`Purchase ${itemName} for ${itemPrice} gold?`)) return;
            
            try {
                const response = await fetch('@Url.Action("Purchase", "Shop")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify({ itemId })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    // Update player gold display
                    document.getElementById('playerGold').textContent = data.player.gold;
                    
                    // Show success animation
                    showPurchaseAnimation(itemName, data.item.rarity);
                    
                    // Refresh page after animation
                    setTimeout(() => {
                        location.reload();
                    }, 2000);
                } else {
                    if (data.deficit) {
                        alert(`Insufficient gold! You need ${data.deficit} more gold.`);
                    } else {
                        alert(data.message || 'Purchase failed');
                    }
                }
            } catch (error) {
                console.error('Error purchasing item:', error);
                alert('Failed to purchase item');
            }
        }
        
        function showPurchaseAnimation(itemName, rarity) {
            const overlay = document.createElement('div');
            overlay.className = 'purchase-overlay';
            overlay.innerHTML = `
                <div class="purchase-popup ${rarity.toLowerCase()}">
                    <div class="purchase-icon">✨</div>
                    <h2>Purchase Successful!</h2>
                    <p class="item-acquired">${itemName}</p>
                    <p class="rarity-label ${rarity.toLowerCase()}">${rarity}</p>
                    <div class="coin-animation">
                        <span class="coin">💰</span>
                        <span class="coin">💰</span>
                        <span class="coin">💰</span>
                    </div>
                </div>
            `;
            document.body.appendChild(overlay);
            
            setTimeout(() => {
                overlay.remove();
            }, 2500);
        }
    </script>
    
    @Html.AntiForgeryToken()
}
